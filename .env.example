# 像素画布服务配置
# 复制本文件为 .env 后按需修改，切勿将含真实密码的 .env 提交到代码仓库。
# 部署说明见 deploy-baota.md

# 监听端口（宝塔放行该端口，或反向代理到此端口）
PORT=3000

# 绑定地址：0.0.0.0 允许外部/局域网访问；127.0.0.1 仅本机（配合反向代理时用）
HOST=0.0.0.0

# 管理员账号
# 仅在数据库尚未初始化（无该管理员）时生效；若库已存在同名管理员则不会覆盖其密码。
ADMIN_USER=admin
ADMIN_PASS=admin123

# MySQL 数据库（默认库名/账号/密码均为 qypixel）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=qypixel
MYSQL_PASS=qypixel
MYSQL_DB=qypixel

# 注册邮箱验证（QQ 邮箱发信）
# 使用 QQ 邮箱的「授权码」（非登录密码）：QQ 邮箱 → 设置 → 账户 → 开启 SMTP 服务后获取
EMAIL_USER=2056242081@qq.com
EMAIL_PASS=请填写你的QQ邮箱授权码

